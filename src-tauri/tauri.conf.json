{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenHarbor",
  "version": "0.2.0-beta.1",
  "identifier": "com.screenharbor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScreenHarbor",
        "width": 680,
        "height": 920,
        "minWidth": 600,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true
      },
      {
        "label": "selection",
        "title": "ScreenHarbor 选区控制",
        "url": "index.html?window=selection-controls",
        "width": 520,
        "height": 56,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "recording-controls",
        "title": "ScreenHarbor 录制控制",
        "url": "index.html?window=recording-controls",
        "width": 680,
        "height": 56,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$VIDEO/ScreenHarbor/**", "$VIDEO/FrameFlow/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "ScreenHarbor Windows screen recorder",
    "longDescription": "A lightweight Windows screen recorder focused on clear capture controls and reliable local output.",
    "resources": {
      "resources/ffmpeg/": "ffmpeg/"
    }
  }
}
