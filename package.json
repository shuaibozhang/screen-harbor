{
  "name": "frameflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @frameflow/desktop-ui",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "package:windows": "tauri build --bundles nsis",
    "build": "npm run build --workspace @frameflow/desktop-ui",
    "test": "npm run test --workspace @frameflow/desktop-ui",
    "typecheck": "npm run typecheck --workspace @frameflow/desktop-ui"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
